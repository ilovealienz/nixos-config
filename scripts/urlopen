#!/bin/sh
# Browser chooser: Enter for the default, right-arrow for others.

set -u

url=${1:-}

# label|command; the first installed one is the default
ENTRIES='librewolf|librewolf
brave|brave
chromium|chromium
librewolf private|librewolf --private-window
brave private|brave --incognito
mpv|mpv
copy|@copy
qr|@qr'

if [ -z "$url" ]; then
    exec librewolf
fi

# keep only entries whose binary exists
avail=$(printf '%s\n' "$ENTRIES" | while IFS='|' read -r label cmd; do
    case "$cmd" in
        @*) printf '%s|%s\n' "$label" "$cmd" ;;
        *)  bin=${cmd%% *}
            command -v "$bin" >/dev/null 2>&1 && printf '%s|%s\n' "$label" "$cmd" ;;
    esac
done)

[ -n "$avail" ] || { notify-send -u critical "urlopen" "nothing available"; exit 1; }

labels=$(printf '%s\n' "$avail" | cut -d'|' -f1)

# host and a short path, to leave room for the options
prompt=$(printf '%s' "$url" | sed -E 's|^[a-z]+://||' | cut -c1-44)
[ "${#url}" -gt 48 ] && prompt="$prompt…"

if [ "$(printf '%s\n' "$labels" | wc -l)" -eq 1 ]; then
    choice=$labels
else
    # colours filled in by programs/core-packages.nix
    choice=$(printf '%s' "$labels" | wmenu -i \
        -p "$prompt" \
        -N @bg@ -n @fg@ -S @accent@ -s @onAccent@ \
        -f 'Inter 13') || exit 0
fi

[ -n "$choice" ] || exit 0

cmd=$(printf '%s\n' "$avail" | awk -F'|' -v l="$choice" '$1==l {print $2; exit}')
[ -n "$cmd" ] || exit 0

case "$cmd" in
    @copy)
        printf '%s' "$url" | wl-copy
        notify-send "urlopen" "copied"
        exit 0
        ;;
    @qr)
        if command -v qrencode >/dev/null 2>&1; then
            qrencode -o - -s 8 -m 2 "$url" | imv - 2>/dev/null &
        else
            notify-send -u critical "urlopen" "qrencode not installed"
        fi
        exit 0
        ;;
esac

# detached, so it outlives the caller
# shellcheck disable=SC2086
setsid -f $cmd "$url" >/dev/null 2>&1
